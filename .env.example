# start.py creates .env and a private local session token automatically.
AUTH_MODE=demo
DEMO_API_TOKEN=
API_URL=http://127.0.0.1:8000

# Works locally without Docker, model downloads or cloud credentials.
RETRIEVAL_MODE=lexical
GENERATION_MODE=auto
AUTO_IMPORT_DATASET=true

# Optional generated answers. Fill the key and enable explicitly, then restart.
# Only authorized evidence allowed by dataset_policies.json is sent.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ENABLE_EXTERNAL_LLM=false
ALLOW_EXTERNAL_CONFIDENTIAL=false

# Optional dense retrieval: install requirements-dense.txt, start Docker services,
# and change RETRIEVAL_MODE=dense. First use downloads the embedding model.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_REVISION=main
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_bge_small_v1
REDIS_URL=
CHUNK_TOKENS=180
CHUNK_OVERLAP=30
TOP_CANDIDATES=16
TOP_K=8
MIN_RETRIEVAL_SCORE=0
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
